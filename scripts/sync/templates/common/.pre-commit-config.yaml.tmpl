# {{header}}
# Install once: uv run --project {{harness_dir}} pre-commit install
repos:
  - repo: local
    hooks:
      - id: rtl-harness-lint
        name: rtl-harness lint (Verible + Verilator + custom checks)
        entry: uv run --project {{harness_dir}} --no-sync rtl-harness lint
        language: system
        files: \.(sv|svh|v|vh)$
        pass_filenames: true

      - id: gitleaks-protect
        name: gitleaks protect --staged
        entry: uv run --project {{harness_dir}} --no-sync python {{harness_dir}}/scripts/ci/gitleaks_hook.py
        language: system
        pass_filenames: false
        always_run: true

      - id: hygiene
        name: hygiene (no absolute paths / internal URLs / e-mails / IPs)
        entry: uv run --project {{harness_dir}} --no-sync python {{harness_dir}}/scripts/ci/hygiene.py --files
        language: system
        types: [text]
        pass_filenames: true
